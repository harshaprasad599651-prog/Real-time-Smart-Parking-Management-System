# ===========================================================================
#  SmartPark - MongoDB settings for the Admin PC
#
#  Edit the real file (Administrator rights needed):
#      C:\Program Files\MongoDB\Server\<version>\bin\mongod.cfg
#  Keep its existing storage/systemLog paths; make sure these two sections match,
#  then restart the service:  services.msc > "MongoDB Server (MongoDB)" > Restart
#  (or, as Administrator:  net stop MongoDB && net start MongoDB)
# ===========================================================================

# Listen on this PC only. The Entry and Exit PCs never talk to MongoDB; they use the
# SmartPark REST API. Do NOT change this to 0.0.0.0 or open port 27017 in the firewall.
net:
  port: 27017
  bindIp: 127.0.0.1

# Require a username and password (create the accounts with create-smartpark-user.js
# BEFORE adding this, otherwise you lock yourself out).
security:
  authorization: enabled
