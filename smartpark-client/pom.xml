<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.smartpark</groupId>
        <artifactId>smartpark</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>smartpark-client</artifactId>
    <packaging>jar</packaging>

    <name>SmartPark Client</name>
    <description>JavaFX desktop client for the Entry, Exit and Admin computers</description>

    <properties>
        <!-- module-name/main-class used by `mvn javafx:run` -->
        <client.main.class>com.smartpark.client/com.smartpark.client.app.SmartParkClientApp</client.main.class>

        <!--
            Optional overrides forwarded to the client JVM by `mvn javafx:run`, e.g.
            mvnw -pl smartpark-client javafx:run -Dsmartpark.server.host=192.168.1.10
            Empty values are ignored and the properties file is used instead.
        -->
        <smartpark.server.host/>
        <smartpark.server.port/>
        <smartpark.terminal.name/>
    </properties>

    <dependencies>
        <!-- JavaFX UI toolkit (javafx-graphics and javafx-base come in transitively) -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
        </dependency>

        <!--
            Java HTTP Client (java.net.http) and its WebSocket API are part of the JDK
            itself, so no Maven dependency is required. See module-info.java.
        -->

        <!-- JSON for REST bodies and real-time events (Jackson 3, version from the Spring Boot BOM) -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Testing (version managed by the Spring Boot BOM imported in the parent) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>smartpark-client</finalName>
        <plugins>
            <!--
                `mvn javafx:run`   runs the client from the sources (development).
                `mvn javafx:jlink` builds a self-contained client for the Entry/Exit/Admin PCs:
                    target/smartpark-client-image/      (Java runtime + JavaFX + the client)
                    target/SmartPark-Client.zip         (the same, zipped for copying)
                The PCs need no JDK or Maven. See docs/DEPLOYMENT.md.
            -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <configuration>
                    <mainClass>${client.main.class}</mainClass>
                    <jlinkImageName>smartpark-client-image</jlinkImageName>
                    <launcher>smartpark-client</launcher>
                    <jlinkZipName>SmartPark-Client</jlinkZipName>
                    <stripDebug>true</stripDebug>
                    <noHeaderFiles>true</noHeaderFiles>
                    <noManPages>true</noManPages>
                    <options>
                        <option>-Dsmartpark.server.host=${smartpark.server.host}</option>
                        <option>-Dsmartpark.server.port=${smartpark.server.port}</option>
                        <option>-Dsmartpark.terminal.name=${smartpark.terminal.name}</option>
                    </options>
                </configuration>
            </plugin>

            <!--
                Runs the command-line real-time test client (no JavaFX needed):
                mvnw -pl smartpark-client compile exec:java -Dexec.args="demo"
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.1</version>
                <configuration>
                    <mainClass>com.smartpark.client.tools.RealtimeTestClient</mainClass>
                    <cleanupDaemonThreads>false</cleanupDaemonThreads>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
