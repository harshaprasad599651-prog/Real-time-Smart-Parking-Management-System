<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.smartpark.client.ui.connections.ConnectionsController" spacing="20">

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="Real-time connections" styleClass="section-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="updatedLabel" styleClass="muted"/>
        <Button text="Refresh" onAction="#onRefresh" styleClass="secondary-button"/>
    </HBox>

    <Label fx:id="errorLabel" styleClass="error-banner" wrapText="true" maxWidth="Infinity"/>

    <FlowPane fx:id="kpis" hgap="16" vgap="16"/>

    <GridPane hgap="20" vgap="20">
        <columnConstraints>
            <ColumnConstraints percentWidth="66"/>
            <ColumnConstraints percentWidth="34"/>
        </columnConstraints>
        <VBox styleClass="card" spacing="12" GridPane.columnIndex="0">
            <Label text="Connected terminals" styleClass="card-title"/>
            <TableView fx:id="clientTable" prefHeight="360" styleClass="data-table"/>
        </VBox>
        <StackPane fx:id="feedHolder" GridPane.columnIndex="1" minHeight="400"/>
    </GridPane>
</VBox>
