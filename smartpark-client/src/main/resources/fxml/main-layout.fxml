<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Sidebar runs the full window height; the right part has its own top bar, content and status bar. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.smartpark.client.ui.shell.MainLayoutController"
            styleClass="app-shell">

    <!-- ============================ Sidebar ============================ -->
    <left>
        <VBox styleClass="sidebar" spacing="6" prefWidth="236" minWidth="236">
            <HBox styleClass="sidebar-brand" spacing="10" alignment="CENTER_LEFT">
                <StackPane fx:id="brandIcon" styleClass="brand-icon-box-small"/>
                <VBox>
                    <Label text="SmartPark" styleClass="sidebar-title"/>
                    <Label text="Parking Management" styleClass="sidebar-subtitle"/>
                </VBox>
            </HBox>

            <Label text="NAVIGATION" styleClass="sidebar-section"/>
            <VBox fx:id="navItems" spacing="4"/>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox styleClass="sidebar-user" spacing="10">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <StackPane fx:id="userAvatar" styleClass="avatar"/>
                    <VBox>
                        <Label fx:id="userName" styleClass="sidebar-user-name"/>
                        <Label fx:id="userRole" styleClass="sidebar-user-role"/>
                    </VBox>
                </HBox>
                <Button fx:id="signOutButton" text="Sign out" onAction="#onSignOut"
                        styleClass="sidebar-signout" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <BorderPane>
            <!-- ======================== Top bar ======================== -->
            <top>
                <HBox styleClass="top-bar" spacing="16" alignment="CENTER_LEFT">
                    <VBox spacing="2">
                        <Label fx:id="pageTitle" styleClass="page-title"/>
                        <Label fx:id="pageSubtitle" styleClass="page-subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <HBox fx:id="statusHolder" alignment="CENTER_LEFT"/>
                    <Label fx:id="roleBadge" styleClass="role-badge"/>
                </HBox>
            </top>

            <!-- ======================== Content ======================== -->
            <center>
                <ScrollPane fx:id="contentScroll" fitToWidth="true" styleClass="content-scroll">
                    <StackPane fx:id="content" styleClass="content-area">
                        <padding><Insets top="24" right="28" bottom="28" left="28"/></padding>
                    </StackPane>
                </ScrollPane>
            </center>

            <!-- ======================= Status bar ====================== -->
            <bottom>
                <HBox styleClass="status-bar" spacing="18" alignment="CENTER_LEFT">
                    <Label fx:id="serverInfo"/>
                    <Label text="·" styleClass="status-sep"/>
                    <Label fx:id="terminalInfo"/>
                    <Label text="·" styleClass="status-sep"/>
                    <Label fx:id="lastUpdate"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="clockLabel" styleClass="status-clock"/>
                </HBox>
            </bottom>
        </BorderPane>
    </center>
</BorderPane>
