<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Admin overview: KPIs, charts, live map with vehicle numbers, activity feed. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.smartpark.client.ui.dashboard.AdminDashboardController" spacing="20">

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="Car park at a glance" styleClass="section-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="updatedLabel" styleClass="muted"/>
        <Button text="Refresh" onAction="#onRefresh" styleClass="secondary-button"/>
    </HBox>

    <Label fx:id="errorLabel" styleClass="error-banner" wrapText="true" maxWidth="Infinity"/>

    <FlowPane fx:id="kpis" hgap="16" vgap="16"/>

    <GridPane hgap="20" vgap="20">
        <columnConstraints>
            <ColumnConstraints percentWidth="36"/>
            <ColumnConstraints percentWidth="64"/>
        </columnConstraints>
        <VBox styleClass="card" spacing="6" GridPane.columnIndex="0">
            <Label text="Slot status" styleClass="card-title"/>
            <PieChart fx:id="statusChart" styleClass="status-pie" prefHeight="260" minHeight="220"/>
        </VBox>
        <VBox styleClass="card" spacing="6" GridPane.columnIndex="1">
            <Label text="Entries and exits per hour (today)" styleClass="card-title"/>
            <BarChart fx:id="trafficChart" styleClass="traffic-chart" prefHeight="260" minHeight="220"
                      barGap="2" categoryGap="10">
                <xAxis><CategoryAxis/></xAxis>
                <yAxis><NumberAxis minorTickVisible="false" tickUnit="1" forceZeroInRange="true"/></yAxis>
            </BarChart>
        </VBox>
    </GridPane>

    <GridPane hgap="20" vgap="20">
        <columnConstraints>
            <ColumnConstraints percentWidth="64"/>
            <ColumnConstraints percentWidth="36"/>
        </columnConstraints>
        <VBox styleClass="card" spacing="14" GridPane.columnIndex="0">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Live parking map" styleClass="card-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="mapSummary" styleClass="map-summary"/>
            </HBox>
            <VBox fx:id="legendHolder"/>
            <StackPane fx:id="mapHolder" alignment="TOP_LEFT"/>
        </VBox>
        <StackPane fx:id="feedHolder" GridPane.columnIndex="1" minHeight="420"/>
    </GridPane>
</VBox>
