<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.smartpark.client.ui.admin.SlotManagementController" spacing="16">

    <Label fx:id="errorLabel" styleClass="error-banner" wrapText="true" maxWidth="Infinity"/>
    <Label fx:id="actionMessage" styleClass="success-banner" wrapText="true" maxWidth="Infinity"/>

    <VBox styleClass="card" spacing="14">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <VBox spacing="2">
                <Label text="Parking slots" styleClass="card-title"/>
                <Label fx:id="summaryLabel" styleClass="muted"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="editButton" text="Edit slot" onAction="#onEdit" styleClass="secondary-button"/>
            <Button fx:id="toggleButton" text="Disable slot" onAction="#onToggle" styleClass="secondary-button"/>
            <Button text="+ Add slot" onAction="#onAdd" styleClass="primary-button"/>
        </HBox>
        <TableView fx:id="table" prefHeight="560" styleClass="data-table"/>
        <Label text="Occupied slots cannot be edited or disabled until the vehicle leaves. Double-click a row to edit."
               styleClass="muted" wrapText="true"/>
    </VBox>
</VBox>
