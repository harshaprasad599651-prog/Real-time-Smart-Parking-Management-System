<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.smartpark.client.ui.admin.UserManagementController" spacing="16">

    <Label fx:id="errorLabel" styleClass="error-banner" wrapText="true" maxWidth="Infinity"/>
    <Label fx:id="actionMessage" styleClass="success-banner" wrapText="true" maxWidth="Infinity"/>

    <VBox styleClass="card" spacing="14">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <VBox spacing="2">
                <Label text="Operator accounts" styleClass="card-title"/>
                <Label fx:id="summaryLabel" styleClass="muted"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="roleButton" text="Assign role" onAction="#onChangeRole" styleClass="secondary-button"/>
            <Button fx:id="activeButton" text="Deactivate" onAction="#onToggleActive" styleClass="secondary-button"/>
            <Button text="+ New operator" onAction="#onCreate" styleClass="primary-button"/>
        </HBox>
        <TableView fx:id="table" prefHeight="460" styleClass="data-table"/>
        <Label wrapText="true" styleClass="muted"
               text="Passwords are stored only as BCrypt hashes. Changing a role or deactivating an account signs that user out on every terminal immediately. You cannot change or deactivate your own account."/>
    </VBox>
</VBox>
