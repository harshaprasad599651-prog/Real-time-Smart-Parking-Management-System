<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.smartpark.client.ui.admin.ActivityLogController" spacing="16">

    <Label fx:id="errorLabel" styleClass="error-banner" wrapText="true" maxWidth="Infinity"/>

    <VBox styleClass="card" spacing="10">
        <Label text="Filter operator activity" styleClass="card-title"/>
        <FlowPane hgap="14" vgap="10" alignment="CENTER_LEFT">
            <VBox spacing="4">
                <Label text="Role" styleClass="field-label"/>
                <ComboBox fx:id="roleBox" prefWidth="170" styleClass="input-combo"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Action" styleClass="field-label"/>
                <ComboBox fx:id="actionBox" prefWidth="210" styleClass="input-combo"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Username" styleClass="field-label"/>
                <TextField fx:id="userField" promptText="any" prefWidth="150" styleClass="input" onAction="#onSearch"/>
            </VBox>
            <HBox spacing="8" alignment="BOTTOM_LEFT">
                <Button text="Search" onAction="#onSearch" styleClass="primary-button"/>
                <Button text="Reset" onAction="#onReset" styleClass="secondary-button"/>
            </HBox>
        </FlowPane>
    </VBox>

    <GridPane hgap="20" vgap="20">
        <columnConstraints>
            <ColumnConstraints percentWidth="68"/>
            <ColumnConstraints percentWidth="32"/>
        </columnConstraints>
        <VBox styleClass="card" spacing="12" GridPane.columnIndex="0">
            <HBox alignment="CENTER_LEFT">
                <Label text="Activity log" styleClass="card-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="countLabel" styleClass="muted"/>
            </HBox>
            <TableView fx:id="table" prefHeight="540" styleClass="data-table"/>
            <Label text="New activity appears at the top automatically." styleClass="muted"/>
        </VBox>
        <VBox styleClass="card" spacing="8" GridPane.columnIndex="1">
            <Label text="Entries and exits by operator" styleClass="card-title"/>
            <BarChart fx:id="operatorChart" styleClass="traffic-chart" prefHeight="320">
                <xAxis><CategoryAxis/></xAxis>
                <yAxis><NumberAxis minorTickVisible="false" tickUnit="1" forceZeroInRange="true"/></yAxis>
            </BarChart>
            <Label text="Counted over the records currently listed." styleClass="muted" wrapText="true"/>
        </VBox>
    </GridPane>
</VBox>
